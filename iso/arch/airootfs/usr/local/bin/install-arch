#!/usr/bin/env bash
# install-arch: holt das Installer-Repo aus main (Fallback: im ISO eingebettet),
# zeigt Version + SHA256 und startet install.sh. Pendant zu install-nixos.
#
# Es wird das komplette Repo geholt (nicht nur install.sh), weil der Installer
# lib/ und hosts/ braucht.
set -Eeuo pipefail

REPO="xXMortiferusXx/arch-linux"
BRANCH="main"
TARBALL="https://github.com/${REPO}/archive/refs/heads/${BRANCH}.tar.gz"
EMBEDDED="/usr/local/share/arch-linux.tar.gz"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

echo
echo "  Arch-Installer"
echo "  ────────────────────────────────────────────"

if curl -fsSL --max-time 60 "$TARBALL" -o "$TMP/repo.tar.gz"; then
  echo "  Quelle : ${TARBALL}"
else
  if [ -f "$EMBEDDED" ]; then
    echo "  Netzwerk nicht erreichbar – nutze eingebettete Fassung"
    cp "$EMBEDDED" "$TMP/repo.tar.gz"
    echo "  Quelle : ${EMBEDDED}"
  else
    echo "  FEHLER: Repo nicht abrufbar und keine eingebettete Fassung" >&2
    exit 1
  fi
fi

echo "  SHA256 : $(sha256sum "$TMP/repo.tar.gz" | cut -d' ' -f1)"
echo "  ────────────────────────────────────────────"
echo

tar xf "$TMP/repo.tar.gz" -C "$TMP"
dir="$(find "$TMP" -maxdepth 1 -type d -name 'arch-linux-*' | head -1)"
[ -n "$dir" ] || { echo "  FEHLER: unerwartetes Archiv" >&2; exit 1; }

exec bash "$dir/install.sh" "$@"
