#!/bin/sh
# Pendant zu nix-check: ausstehende Updates (pacman + AUR) und Reboot-Bedarf.
set -u
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-}" != dumb ]; then
  ACC=$(printf '\033[38;5;39m'); OKC=$(printf '\033[38;5;42m')
  WRN=$(printf '\033[38;5;214m'); DIM=$(printf '\033[38;5;245m')
  BLD=$(printf '\033[1m'); RST=$(printf '\033[0m')
else
  ACC=""; OKC=""; WRN=""; DIM=""; BLD=""; RST=""
fi
ui_title() { printf '\n%s%s%s\n' "$BLD$ACC" "$1" "$RST"; printf '%s' "$DIM"; printf '%.0s─' $(seq 1 52); printf '%s\n' "$RST"; }
ui_step()  { printf '\n%s▸%s %s%s%s\n' "$ACC" "$RST" "$BLD" "$1" "$RST"; }
ui_ok()    { printf '  %s✔%s %s\n' "$OKC" "$RST" "$1"; }
ui_warn()  { printf '  %s▲%s %s\n' "$WRN" "$RST" "$1"; }
ui_info()  { printf '  %s•%s %s\n' "$DIM" "$RST" "$1"; }

ui_title "Arch Status"

ui_step "Offizielle Updates"
if command -v checkupdates >/dev/null 2>&1; then
  out=$(checkupdates 2>/dev/null || true)
  n=$(printf '%s' "$out" | grep -c . || true)
  if [ "$n" -eq 0 ]; then
    ui_ok "keine"
  else
    ui_warn "$n Pakete"
    printf '%s\n' "$out" | sed 's/^/    /'
  fi
else
  ui_info "checkupdates fehlt (pacman-contrib)"
fi

ui_step "AUR-Updates"
if command -v paru >/dev/null 2>&1; then
  out=$(paru -Qua 2>/dev/null || true)
  n=$(printf '%s' "$out" | grep -c . || true)
  if [ "$n" -eq 0 ]; then ui_ok "keine"; else ui_warn "$n Pakete"; printf '%s\n' "$out" | sed 's/^/    /'; fi
else
  ui_info "paru nicht installiert"
fi

ui_step "Reboot-Status"
running=$(uname -r)
newest=$(ls /usr/lib/modules 2>/dev/null | sort -V | tail -1)
if [ -n "$newest" ] && [ "$running" != "$newest" ]; then
  ui_warn "neuer Kernel installiert ($running → $newest)"
else
  ui_ok "Kernel aktuell ($running)"
fi

if [ -e /proc/driver/nvidia/version ]; then
  modv=$(sed -n 's/.*Module  *\([0-9.]*\).*/\1/p' /proc/driver/nvidia/version | head -1)
  pkgv=$(pacman -Q nvidia-utils 2>/dev/null | awk '{print $2}' | cut -d- -f1)
  if [ -n "$pkgv" ] && [ "$modv" != "$pkgv" ]; then
    ui_warn "NVIDIA-Modul $modv ≠ Paket $pkgv (Reboot nötig)"
  fi
fi

ui_step "Hinweis"
ui_info "Dienste mit alten Bibliotheken: sudo checkservices"
