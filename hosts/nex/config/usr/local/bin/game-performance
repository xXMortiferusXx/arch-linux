#!/bin/sh
# aus modules/programs/gaming/scripts.nix: Performance-Profil + volle
# Helligkeit + Inhibit; beim Beenden zurueck auf balanced/80 %.
# EPP/Governor macht power-profiles-daemon (set performance).
set -u
PCTL=powerprofilesctl
BCTL=brightnessctl

$BCTL set 100% 2>/dev/null
$PCTL set performance 2>/dev/null

restore() {
  $PCTL set balanced 2>/dev/null
  $BCTL set 80% 2>/dev/null
}
trap restore EXIT

echo "--- BEAST MODE: Performance-Profile + Inhibit ---"
systemd-inhibit --why "game-performance running" "$@"
exit $?
