#!/bin/sh
# aus modules/hardware/touchpad.nix: Touchpad deaktivieren, sobald eine
# externe Maus haengt (udev-add/remove auf mouse*-Nodes).
TOUCHPAD_INHIBIT=""
for dev in /sys/class/input/event*/; do
  devname=$(cat "$dev/device/name" 2>/dev/null || true)
  case "$devname" in
    *[Tt]ouchpad*|*[Tt]rackpad*) TOUCHPAD_INHIBIT="$dev/device/inhibited"; break ;;
  esac
done
[ -n "$TOUCHPAD_INHIBIT" ] || exit 0

EXT_MOUSE=0
for mouse in /sys/class/input/mouse*/; do
  devname=$(cat "$mouse/device/name" 2>/dev/null || true)
  case "$devname" in
    *ELAN*|*[Tt]ouchpad*|*[Tt]rackpad*|*ynaptics*) ;;
    *) EXT_MOUSE=$((EXT_MOUSE + 1)) ;;
  esac
done

if [ "$EXT_MOUSE" -gt 0 ]; then
  echo 1 > "$TOUCHPAD_INHIBIT"
else
  echo 0 > "$TOUCHPAD_INHIBIT"
fi
