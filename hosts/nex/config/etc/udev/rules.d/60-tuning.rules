# I/O-Scheduler (nur ganze Datentraeger, nur eingebaute, nur wenn angeboten)
ACTION=="add|change", SUBSYSTEM=="block", KERNEL=="nvme[0-9]*n[0-9]*", ENV{DEVTYPE}=="disk", ATTR{queue/scheduler}=="*kyber*", ATTR{queue/scheduler}="kyber"
ACTION=="add|change", SUBSYSTEM=="block", KERNEL=="sd*|mmcblk*", ENV{DEVTYPE}=="disk", ATTR{removable}=="0", ATTR{queue/rotational}=="0", ATTR{queue/scheduler}=="*kyber*", ATTR{queue/scheduler}="kyber"
ACTION=="add|change", SUBSYSTEM=="block", KERNEL=="sd*", ENV{DEVTYPE}=="disk", ATTR{removable}=="0", ATTR{queue/rotational}=="1", ATTR{queue/scheduler}=="*bfq*", ATTR{queue/scheduler}="bfq"

# zram: swappiness beim Init hochsetzen + zswap aus
ACTION=="change", KERNEL=="zram0", ATTR{initstate}=="1", SYSCTL{vm.swappiness}="150", RUN+="/bin/sh -c 'echo N > /sys/module/zswap/parameters/enabled'"

# CachyOS: audio-Gruppe darf CPU-DMA-Latenz setzen
DEVPATH=="/devices/virtual/misc/cpu_dma_latency", OWNER="root", GROUP="audio", MODE="0660"
KERNEL=="rtc0", GROUP="audio"
KERNEL=="hpet", GROUP="audio"

# AC -> snd-hda-intel power_save=0 (kein Crackling)
ACTION=="add", SUBSYSTEM=="sound", KERNEL=="card*", DRIVERS=="snd_hda_intel", TEST!="/run/udev/snd-hda-intel-powersave", RUN+="/bin/sh -c 'touch /run/udev/snd-hda-intel-powersave; for bat in /sys/class/power_supply/BAT*; do [ \"$(cat $bat/status 2>/dev/null)\" != \"Discharging\" ] && { echo $(cat /sys/module/snd_hda_intel/parameters/power_save) > /run/udev/snd-hda-intel-powersave; echo 0 > /sys/module/snd_hda_intel/parameters/power_save; break; }; done'"
SUBSYSTEM=="power_supply", ENV{POWER_SUPPLY_ONLINE}=="0", TEST=="/sys/module/snd_hda_intel", RUN+="/bin/sh -c 'echo $(cat /run/udev/snd-hda-intel-powersave 2>/dev/null || echo 1) > /sys/module/snd_hda_intel/parameters/power_save'"
SUBSYSTEM=="power_supply", ENV{POWER_SUPPLY_ONLINE}=="1", TEST=="/sys/module/snd_hda_intel", RUN+="/bin/sh -c 'CUR=$(cat /sys/module/snd_hda_intel/parameters/power_save); [ \"$CUR\" != 0 ] && echo $CUR > /run/udev/snd-hda-intel-powersave; echo 0 > /sys/module/snd_hda_intel/parameters/power_save'"
