# Session-Variablen (aus modules/desktop/desktop.nix, environment-common.nix,
# environment-nex.nix und hardware/nvidia-prime.nix)
XCURSOR_THEME=Bibata-Modern-Ice
XCURSOR_SIZE=24
QT_QPA_PLATFORMTHEME=qt6ct
TRACKER_USE_RUNNER=0
TZ=Europe/Berlin
# Electron/Chromium nativ auf Wayland (Pendant zu NIXOS_OZONE_WL)
ELECTRON_OZONE_PLATFORM_HINT=auto

# Compositor/Display laeuft auf der iGPU (radeonsi)
LIBVA_DRIVER_NAME=radeonsi
VDPAU_DRIVER=radeonsi
# VRR nur fuer prime-run-Spiele
__GL_VRR_ALLOWED=1
# NVIDIA Shader-Disk-Cache (12 GB) gegen Stutter
__GL_SHADER_DISK_CACHE_SIZE=12000000000
# wlroots darf auf Software-Rendering zurueckfallen (VM/Remote)
WLR_RENDERER_ALLOW_SOFTWARE=1
