# Host-Features (Umgebung hat Vorrang)
# benny: Desktop, Intel i5-3xxx (Ivy Bridge) + HD 2500/4000.
# Status: VORBEREITET, auf Hardware noch nicht getestet.
: "${USERNAME:=benny}"
: "${GPU:=intel}"
: "${SUNSHINE:=0}"
: "${SCANNER:=0}"
: "${FLATPAK:=1}"
: "${LAPTOP:=0}"
: "${SSHD:=1}"
# I2C=1 wie in der NixOS-Config (ddcutil + i2c-Gruppe + udev-Regel)
: "${I2C:=1}"
: "${EXTRA_GROUPS:=}"
: "${NOPASSWD_SUDO:=0}"
: "${BEDROCK:=0}"
: "${FAUGUS:=0}"
: "${ORCA:=0}"
