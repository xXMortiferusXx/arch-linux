#!/usr/bin/env bash
# apply-config – verwaltete Dateien aus dem Repo auf ein laufendes System
# bringen (Pendant zu "nixos-rebuild switch", aber nur fuer Configs).
#
#   sudo ./bin/apply-config --list      verwaltete Pfade zeigen
#   sudo ./bin/apply-config --verify    nur vergleichen (Exit 1 bei Abweichung)
#   sudo ./bin/apply-config --status    Repo-Stand, angewendeter Stand, Drift
#   sudo ./bin/apply-config --dry-run   Aenderungen + Diff zeigen, nichts schreiben
#   sudo ./bin/apply-config             anwenden (mit tar-Backup vorher)
#   sudo ./bin/apply-config --restore last
#   sudo ./bin/apply-config --restore 2026-11-26_113000
#
# Verwaltet werden:
#   * shared/config + hosts/<host>/config          -> /etc, /usr/local, /usr/share
#   * shared/home + hosts/<host>/home, aber NUR die
#     unten in HOME_PREFIXES gelisteten Pfade      -> ~ des aufrufenden Users
#
# Bewusst NICHT enthalten: restliches /home, /boot, Paket-DB, Kernel-Cmdline,
# Benutzerverwaltung. Es wird nie etwas geloescht.
set -Eeuo pipefail
umask 022

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
REPO_DIR="${ARCH_REPO_DIR:-$(cd -- "$(dirname -- "$SELF")/.." && pwd)}"
BACKUP_DIR="/var/backups/arch-config"
STATE_DIR="/var/lib/arch-config"
KEEP_BACKUPS=10     # Anzahl der aufbewahrten Backups
KEEP_DAYS=90        # zusaetzlich: aelter als das wird geloescht

# Home-Pfade, die als deklarativ gelten und mitverwaltet werden.
# Alles andere unter home/ bleibt unangetastet (Nutzerdaten!).
HOME_PREFIXES=(
  ".config/umbriel/"
)

HOST="${HOST:-$(uname -n)}"
MODE="apply"
RESTORE_ARG=""
HOME_USER="${SUDO_USER:-$(id -un)}"
HOME_DIR=""

info() { printf '  %s\n' "$*"; }
ok()   { printf '  \033[32mOK\033[0m   %s\n' "$*"; }
warn() { printf '  \033[33mWARN\033[0m %s\n' "$*" >&2; }
die()  { printf '  \033[31mFEHLER\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
  sed -n '2,20p' "$SELF" | sed 's/^# \{0,1\}//'
  echo
  echo "Optionen: --list --verify --status --dry-run --restore <last|stamp>"
  echo "          --host <name>   (Standard: $(uname -n))"
  echo "          --user <name>   (Home-Ziel, Standard: aufrufender User)"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --list)    MODE="list" ;;
    --verify)  MODE="verify" ;;
    --status)  MODE="status" ;;
    --dry-run) MODE="dry" ;;
    --restore) MODE="restore"; RESTORE_ARG="${2:-}"; shift ;;
    --host)    HOST="${2:-}"; shift ;;
    --user)    HOME_USER="${2:-}"; shift ;;
    -h|--help) usage; exit 0 ;;
    *)         die "Unbekannte Option: $1" ;;
  esac
  shift
done

# Nur --list kommt ohne root aus: /etc/polkit-1 u. a. sind fuer normale
# Benutzer nicht lesbar, sonst entstehen Fehlalarme.
if [ "$MODE" != "list" ] && [ "$(id -u)" != 0 ]; then
  die "Bitte mit sudo starten (nur --list geht ohne root)."
fi

[ -d "$REPO_DIR/hosts/$HOST/config" ] \
  || die "Kein Host-Profil: hosts/$HOST/config fehlt (Hostname pruefen oder --host)"

if [ -n "$HOME_USER" ]; then
  HOME_DIR="$(getent passwd "$HOME_USER" | cut -d: -f6 || true)"
fi

# --- Sammlung: Zielpfad -> Quelle -----------------------------------------
declare -A SRC=()     # Ziel (absolut) -> Quelle im Repo
declare -A OWNER=()   # Ziel -> "root" oder "user"

add_file() {
  local src="$1" dst="$2" owner="$3"
  SRC["$dst"]="$src"; OWNER["$dst"]="$owner"
}

# Ziel-Modus: unabhaengig davon, ob die Quelle aus einem Git-Checkout (644/755)
# oder einem GitHub-Tarball (664/775) kommt.
desired_mode() { if [ -x "$1" ]; then echo 755; else echo 644; fi; }

is_home_managed() {
  local rel="$1" p
  # Von Noctalia erzeugt (Farben/Templates) - nicht aus dem Repo diktieren,
  # sonst ueberschreibt jeder Apply die aktuell synchronisierten Farben.
  case "${rel##*/}" in noctalia.toml) return 1 ;; esac
  for p in "${HOME_PREFIXES[@]}"; do
    case "$rel" in "$p"*) return 0 ;; esac
  done
  return 1
}

collect_system() {
  local root="$1" rel
  [ -d "$root" ] || return 0
  while IFS= read -r rel; do
    case "$rel" in README.md|*/README.md) continue ;; esac
    case "/$rel" in
      /etc/*|/usr/local/*|/usr/share/*) add_file "$root/$rel" "/$rel" root ;;
      *) warn "uebersprungen (Pfad nicht erlaubt): /$rel" ;;
    esac
  done < <(cd "$root" && find . -type f -printf '%P\n' | LC_ALL=C sort)
}

collect_home() {
  local root="$1" rel
  [ -d "$root" ] || return 0
  [ -n "$HOME_DIR" ] || return 0
  while IFS= read -r rel; do
    case "$rel" in README.md|*/README.md) continue ;; esac
    is_home_managed "$rel" || continue
    add_file "$root/$rel" "$HOME_DIR/$rel" user
  done < <(cd "$root" && find . -type f -printf '%P\n' | LC_ALL=C sort)
}

collect_system "$REPO_DIR/shared/config"
collect_system "$REPO_DIR/hosts/$HOST/config"
collect_home   "$REPO_DIR/shared/home"
collect_home   "$REPO_DIR/hosts/$HOST/home"

[ "${#SRC[@]}" -gt 0 ] || die "Keine verwalteten Dateien gefunden"

# --- Vergleich -------------------------------------------------------------
CHANGED=()
for dst in $(printf '%s\n' "${!SRC[@]}" | LC_ALL=C sort); do
  src="${SRC[$dst]}"
  if [ ! -e "$dst" ] \
     || [ "$(desired_mode "$src")" != "$(stat -c %a "$dst" 2>/dev/null || echo '?')" ] \
     || ! cmp -s "$src" "$dst"; then
    CHANGED+=("$dst")
  fi
done

show_target() {
  # Achtung: kein "~" direkt als Ersatz benutzen - Bash würde es zum
  # Home des ausfuehrenden Users (root) expandieren.
  local p="$1" t="~"
  if [ -n "$HOME_DIR" ]; then printf '%s\n' "${p/#$HOME_DIR/$t}"
  else printf '%s\n' "$p"; fi
}

case "$MODE" in
  list)
    info "Host: $HOST   Repo: $REPO_DIR"
    [ -n "$HOME_DIR" ] && info "Home-Ziel: $HOME_USER ($HOME_DIR)"
    for dst in $(printf '%s\n' "${!SRC[@]}" | LC_ALL=C sort); do show_target "$dst"; done
    echo "---- ${#SRC[@]} Dateien"
    exit 0
    ;;
  status)
    info "Host:        $HOST"
    if git -C "$REPO_DIR" rev-parse --short HEAD >/dev/null 2>&1; then
      info "Repo-HEAD:   $(git -C "$REPO_DIR" rev-parse --short HEAD)"
    else
      info "Repo-HEAD:   (kein Git-Checkout)"
    fi
    if [ -f "$STATE_DIR/applied" ]; then
      IFS=$'\t' read -r c d n < "$STATE_DIR/applied" || true
      info "Angewendet:  ${c:-?}  (${d:-?}, ${n:-?} Dateien)"
    else
      info "Angewendet:  noch nie"
    fi
    if [ "${#CHANGED[@]}" -eq 0 ]; then
      ok "keine Abweichungen (${#SRC[@]} Dateien)"
    else
      warn "${#CHANGED[@]} von ${#SRC[@]} Dateien weichen ab:"
      for dst in "${CHANGED[@]}"; do printf '    %s\n' "$(show_target "$dst")"; done
      exit 1
    fi
    exit 0
    ;;
  verify)
    if [ "${#CHANGED[@]}" -eq 0 ]; then
      ok "keine Abweichungen (${#SRC[@]} Dateien)"
      exit 0
    fi
    warn "${#CHANGED[@]} von ${#SRC[@]} Dateien weichen ab:"
    for dst in "${CHANGED[@]}"; do printf '    %s\n' "$(show_target "$dst")"; done
    exit 1
    ;;
  dry)
    info "Host: $HOST"
    if [ "${#CHANGED[@]}" -eq 0 ]; then ok "keine Aenderungen"; exit 0; fi
    for dst in "${CHANGED[@]}"; do
      echo
      echo "--- $(show_target "$dst")"
      if [ -e "$dst" ]; then
        if cmp -s "$dst" "${SRC[$dst]}"; then
          echo "    (nur Rechte: $(stat -c %a "$dst") -> $(desired_mode "${SRC[$dst]}"))"
        else
          diff -u "$dst" "${SRC[$dst]}" | sed -n '1,80p' || true
        fi
      else
        echo "    (neu)"
        sed -n '1,20p' "${SRC[$dst]}" | sed 's/^/    /'
      fi
    done
    echo
    info "${#CHANGED[@]} Dateien wuerden geschrieben"
    exit 0
    ;;
esac

# --- anwenden --------------------------------------------------------------
record_state() {
  local n="$1" ref
  if git -C "$REPO_DIR" rev-parse --short HEAD >/dev/null 2>&1; then
    ref="$(git -C "$REPO_DIR" rev-parse --short HEAD)"
  else
    ref="tarball:$(date +%F)"
  fi
  install -d -m 755 "$STATE_DIR"
  printf '%s\t%s\t%s\n' "$ref" "$(date -Iseconds)" "$n" > "$STATE_DIR/applied"
}

prune_backups() {
  local f removed=0 count
  while IFS= read -r f; do rm -f "$f"; removed=$((removed+1)); done < <(
    find "$BACKUP_DIR" -maxdepth 1 -name '*.tar.gz' -type f -mtime +"$KEEP_DAYS" 2>/dev/null
  )
  count=$(find "$BACKUP_DIR" -maxdepth 1 -name '*.tar.gz' -type f 2>/dev/null | wc -l)
  if [ "$count" -gt "$KEEP_BACKUPS" ]; then
    while IFS= read -r f; do rm -f "$f"; removed=$((removed+1)); done < <(
      find "$BACKUP_DIR" -maxdepth 1 -name '*.tar.gz' -type f -printf '%f\n' 2>/dev/null \
        | LC_ALL=C sort | head -n "$((count-KEEP_BACKUPS))" | sed "s|^|$BACKUP_DIR/|"
    )
  fi
  [ "$removed" -gt 0 ] && info "alte Backups entfernt: $removed"
  return 0
}

apply_all() {
  local dst src mode uid gid
  install -d -m 755 "$BACKUP_DIR"
  prune_backups

  if [ "${#CHANGED[@]}" -eq 0 ]; then
    ok "bereits aktuell (${#SRC[@]} Dateien) – nichts zu tun"
    record_state 0
    return 0
  fi

  local stamp list existing=()
  stamp="$(date +%F_%H%M%S)"
  list="$(mktemp)"
  for dst in "${CHANGED[@]}"; do [ -e "$dst" ] && existing+=("${dst#/}"); done
  if [ "${#existing[@]}" -gt 0 ]; then
    printf '%s\n' "${existing[@]}" > "$list"
    tar -C / -czf "$BACKUP_DIR/$stamp.tar.gz" -T "$list" \
      || { rm -f "$list"; die "Backup fehlgeschlagen – nichts geaendert"; }
    info "Backup: $BACKUP_DIR/$stamp.tar.gz (${#existing[@]} Dateien)"
  else
    info "kein Backup noetig (nur neue Dateien)"
  fi
  rm -f "$list"

  for dst in "${CHANGED[@]}"; do
    src="${SRC[$dst]}"
    mode="$(desired_mode "$src")"
    if [ "${OWNER[$dst]}" = "user" ]; then
      uid="$(id -u "$HOME_USER")"; gid="$(id -g "$HOME_USER")"
      install -d -m 755 -o "$uid" -g "$gid" "$(dirname "$dst")"
      install -m "$mode" -o "$uid" -g "$gid" "$src" "$dst"
    else
      install -D -m "$mode" -o 0 -g 0 "$src" "$dst"
    fi
    echo "    $(show_target "$dst")"
  done

  systemctl daemon-reload || warn "daemon-reload fehlgeschlagen"
  if [ -n "${SUDO_USER:-}" ] && [ -d "/run/user/$(id -u "$SUDO_USER")" ]; then
    runuser -u "$SUDO_USER" -- env XDG_RUNTIME_DIR="/run/user/$(id -u "$SUDO_USER")" \
      systemctl --user daemon-reload 2>/dev/null || true
  fi
  record_state "${#CHANGED[@]}"
  ok "${#CHANGED[@]} Dateien angewendet"
  info "Umbriel/Noctalia lesen ihre Config beim Speichern neu; sonst neu einloggen."
}

restore_backup() {
  local arg="$1" file
  [ -d "$BACKUP_DIR" ] || die "Kein Backup-Verzeichnis vorhanden"
  if [ "$arg" = "last" ]; then
    file="$(find "$BACKUP_DIR" -maxdepth 1 -name '*.tar.gz' -type f -printf '%f\n' \
      | LC_ALL=C sort | tail -1)"
    [ -n "$file" ] || die "Kein Backup gefunden"
    file="$BACKUP_DIR/$file"
  else
    file="$BACKUP_DIR/$arg.tar.gz"
    [ -f "$file" ] || die "Backup nicht gefunden: $file"
  fi
  info "Zurueckrollen: $file"
  tar -C / -xzf "$file" || die "Restore fehlgeschlagen"
  systemctl daemon-reload || warn "daemon-reload fehlgeschlagen"
  ok "wiederhergestellt (Stand vor dem letzten Apply)"
}

case "$MODE" in
  apply)   apply_all ;;
  restore) [ -n "$RESTORE_ARG" ] || die "--restore braucht 'last' oder einen Zeitstempel"
           restore_backup "$RESTORE_ARG" ;;
esac
